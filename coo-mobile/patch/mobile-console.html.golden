<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#F5F7F8" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#11171A" media="(prefers-color-scheme: dark)">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Coo">
<meta name="application-name" content="Coo">
<link rel="manifest" href="/web/manifest.json">
<link rel="apple-touch-icon" href="/web/icon-192.png">
<link rel="icon" type="image/png" sizes="192x192" href="/web/icon-192.png">
<title>Coo 控制台</title>
<style>
:root{
  --bg:#F5F7F8; --surface:#FFFFFF; --surface-2:#F8FAFA; --line:#E5EAEB;
  --text:#1B2226; --muted:#78848B; --faint:#A7B0B5;
  --accent:#33897F; --accent-2:#4F6B9A; --accent-soft:#E6F3F0;
  --on:#2F9E8B; --off:#CBD3D6; --warn:#B8833C; --warn-soft:#FCF3E4;
  --danger:#C2555B; --danger-soft:#FBECEC;
  --shadow:0 1px 2px rgba(24,44,52,.04),0 8px 24px rgba(24,44,52,.05);
  --radius:18px;
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#11171A; --surface:#1C2428; --surface-2:#222C31; --line:#2C383E;
    --text:#E9EFEF; --muted:#94A3A9; --faint:#6C7B82;
    --accent:#6FC9BB; --accent-2:#8FA9D6; --accent-soft:#1E3A37;
    --on:#3EAE99; --off:#3A474D; --warn:#D6A45F; --warn-soft:#3A3122;
    --danger:#E08085; --danger-soft:#3A2426;
    --shadow:0 1px 2px rgba(0,0,0,.2),0 10px 28px rgba(0,0,0,.22);
  }
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0}
body{
  background:var(--bg);color:var(--text);
  font-family:system-ui,-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;
  font-size:15px;line-height:1.55;-webkit-font-smoothing:antialiased;
  min-height:100vh;
}
body::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
  background:
    radial-gradient(620px 300px at 12% -8%,rgba(47,158,139,.13),transparent 72%),
    radial-gradient(520px 280px at 96% -2%,rgba(79,107,154,.10),transparent 72%);
}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
.app{position:relative;z-index:1;max-width:600px;margin:0 auto;padding:0 16px calc(28px + env(safe-area-inset-bottom))}

/* ---------- top bar ---------- */
.topbar{
  position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:12px;
  padding:calc(14px + env(safe-area-inset-top)) 0 12px;
  background:color-mix(in srgb,var(--bg) 82%,transparent);
  backdrop-filter:saturate(160%) blur(14px);-webkit-backdrop-filter:saturate(160%) blur(14px);
}
.brand{display:flex;align-items:center;gap:11px;min-width:0;flex:1}
.avatar{
  width:42px;height:42px;flex:0 0 42px;border-radius:14px;overflow:hidden;
  display:grid;place-items:center;font-size:22px;
  background:linear-gradient(145deg,var(--accent-soft),var(--surface));
  border:1px solid var(--line);box-shadow:var(--shadow);
}
.avatar img{width:100%;height:100%;object-fit:cover}
.brand-text{min-width:0}
.title{font-size:17px;font-weight:700;letter-spacing:.2px;line-height:1.25}
.subtitle{font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.icon-btn{
  width:36px;height:36px;flex:0 0 36px;display:grid;place-items:center;
  border:1px solid var(--line);background:var(--surface);border-radius:12px;
  font-size:18px;color:var(--muted);box-shadow:var(--shadow);transition:transform .2s,color .2s;
}
.icon-btn:active{transform:scale(.92)}
.icon-btn.spin{animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* ---------- tabs ---------- */
.tabs{
  display:flex;gap:4px;padding:4px;margin:6px 0 18px;
  background:var(--surface-2);border:1px solid var(--line);border-radius:14px;
}
.tab{
  flex:1;border:0;background:transparent;border-radius:10px;padding:9px 4px;
  font-size:13px;font-weight:600;color:var(--muted);transition:.18s;
}
.tab.active{background:var(--surface);color:var(--accent);box-shadow:var(--shadow)}
.panel{display:none;animation:fade .25s ease}
.panel.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

/* ---------- search + stats ---------- */
.search-wrap{position:relative;margin-bottom:12px}
.search-wrap input{
  width:100%;padding:11px 14px 11px 38px;border-radius:13px;
  border:1px solid var(--line);background:var(--surface);outline:none;
  box-shadow:var(--shadow);font-size:14px;
}
.search-wrap input:focus{border-color:var(--accent)}
.search-wrap .glass{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--faint);font-size:15px}
.stats{display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap}
.stat{
  flex:1;min-width:96px;background:var(--surface);border:1px solid var(--line);
  border-radius:14px;padding:10px 12px;box-shadow:var(--shadow);
}
.stat b{display:block;font-size:20px;line-height:1.2;color:var(--accent)}
.stat span{font-size:11px;color:var(--muted)}

/* ---------- cards ---------- */
.card{
  background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
  box-shadow:var(--shadow);padding:15px 16px;margin-bottom:12px;
}
.world-head{display:flex;align-items:center;gap:12px}
.world-icon{
  width:40px;height:40px;flex:0 0 40px;border-radius:13px;display:grid;place-items:center;
  font-size:20px;background:var(--surface-2);border:1px solid var(--line);
}
.world-meta{flex:1;min-width:0}
.world-name{font-weight:650;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.world-id{font-size:11px;color:var(--faint);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.world-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
.badge,.tag,.chip{
  font-size:11px;line-height:1.5;padding:2px 9px;border-radius:99px;
  background:var(--surface-2);border:1px solid var(--line);color:var(--muted);white-space:nowrap;
}
.badge.active{background:var(--accent-soft);color:var(--accent);border-color:transparent}
.badge.missing{background:var(--danger-soft);color:var(--danger);border-color:transparent}
.tag.warn,.chip.warn{background:var(--warn-soft);color:var(--warn);border-color:transparent}
.lamps{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px}
.lamp{font-size:11px;color:var(--muted);display:inline-flex;align-items:center;gap:5px}
.lamp::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--off)}
.lamp.online::before{background:var(--on)}
.lamp.offline::before{background:var(--faint)}
.lamp.busy::before{background:var(--warn)}
.world-foot{
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  margin-top:13px;padding-top:12px;border-top:1px solid var(--line);
}
.mini-toggle{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--muted);cursor:pointer}
.mini-toggle input{width:15px;height:15px;accent-color:var(--accent);margin:0}
.mini-toggle input:disabled{opacity:.4}
.world-actions{display:flex;gap:6px}
.btn{
  border:1px solid var(--line);background:var(--surface-2);color:var(--text);
  border-radius:10px;padding:8px 14px;font-size:13px;font-weight:600;transition:.18s;
}
.btn:active{transform:scale(.96)}
.btn.tiny{padding:5px 11px;font-size:12px;border-radius:9px}
.btn.ghost{background:transparent;color:var(--muted)}
.btn.primary{background:var(--accent);border-color:transparent;color:#fff}
.btn.primary:disabled{opacity:.42;cursor:default}
.btn.danger{background:var(--danger);border-color:transparent;color:#fff}
.btn:disabled{opacity:.45}
.world-detail{margin-top:12px;padding-top:12px;border-top:1px dashed var(--line);font-size:12px;color:var(--muted)}
.detail-row{margin-bottom:8px;word-break:break-word}
.detail-row b{color:var(--text);font-weight:600}
.tool-chips{display:flex;flex-wrap:wrap;gap:5px;margin-top:5px}
.tool-chip{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:10.5px;background:var(--surface-2);border:1px solid var(--line);border-radius:6px;padding:2px 6px}

/* ---------- switch ---------- */
.switch{position:relative;display:inline-block;width:46px;height:27px;flex:0 0 46px}
.switch input{position:absolute;opacity:0;width:100%;height:100%;margin:0;z-index:2;cursor:pointer}
.switch input:disabled{cursor:default}
.slider{position:absolute;inset:0;background:var(--off);border-radius:99px;transition:background .22s}
.slider::before{
  content:"";position:absolute;width:21px;height:21px;left:3px;top:3px;border-radius:50%;
  background:#fff;box-shadow:0 1px 4px rgba(0,0,0,.22);transition:transform .22s;
}
.switch input:checked + .slider{background:var(--on)}
.switch input:checked + .slider::before{transform:translateX(19px)}
.switch input:disabled + .slider{opacity:.45}

/* ---------- config groups ---------- */
.cat-title{
  display:flex;align-items:center;gap:8px;margin:20px 2px 10px;
  font-size:12px;font-weight:700;color:var(--muted);letter-spacing:.6px;
}
.cat-title:first-child{margin-top:4px}
.cat-title span{font-weight:500;color:var(--faint)}
.group{padding:0;overflow:hidden}
.group summary{
  list-style:none;display:flex;align-items:center;gap:10px;padding:15px 16px;cursor:pointer;
}
.group summary::-webkit-details-marker{display:none}
.group summary .g-text{flex:1;min-width:0}
.group-title{font-weight:650;font-size:14.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.group-sub{font-size:11px;color:var(--faint);margin-top:1px}
.chevron{color:var(--faint);font-size:20px;transition:transform .2s}
.group[open] .chevron{transform:rotate(90deg)}
.group-body{padding:0 16px 16px;border-top:1px solid var(--line)}
.group-desc{font-size:12px;color:var(--muted);margin:12px 0 4px;line-height:1.6}
.field{padding:13px 0;border-bottom:1px solid var(--line)}
.field:last-of-type{border-bottom:0}
.field-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
.field-label{font-size:13.5px;font-weight:600;line-height:1.45}
.field-desc{font-size:11.5px;color:var(--muted);line-height:1.55;margin-top:3px}
.field-ctl{margin-top:10px}
.field input[type=text],.field input[type=number],.field select{
  width:100%;padding:9px 11px;border-radius:10px;border:1px solid var(--line);
  background:var(--surface-2);outline:none;font-size:14px;
}
.field input:focus,.field select:focus{border-color:var(--accent)}
.field .row-switch{display:flex;align-items:center;justify-content:space-between}
.range-row{display:flex;align-items:center;gap:12px}
.range-row input[type=range]{flex:1;accent-color:var(--accent);height:22px}
.range-out{
  min-width:56px;text-align:center;font-size:12px;font-variant-numeric:tabular-nums;
  color:var(--accent);background:var(--accent-soft);border-radius:8px;padding:4px 6px;
}
.hint{font-size:11px;color:var(--faint)}
.savebar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-top:14px;margin-top:4px;border-top:1px solid var(--line)}

/* ---------- misc ---------- */
.empty{text-align:center;padding:44px 20px;color:var(--muted);font-size:13px}
.empty .big{font-size:32px;display:block;margin-bottom:10px;opacity:.6}
.skeleton{height:74px;border-radius:var(--radius);margin-bottom:12px;
  background:linear-gradient(90deg,var(--surface-2) 25%,var(--line) 50%,var(--surface-2) 75%);
  background-size:200% 100%;animation:shimmer 1.4s infinite;border:1px solid var(--line)}
@keyframes shimmer{to{background-position:-200% 0}}
.toast{
  position:fixed;z-index:60;left:50%;top:calc(env(safe-area-inset-top) + 14px);
  transform:translate(-50%,-16px);opacity:0;pointer-events:none;
  background:var(--text);color:var(--bg);padding:10px 18px;border-radius:99px;
  font-size:13px;font-weight:600;box-shadow:0 8px 28px rgba(0,0,0,.2);
  transition:opacity .22s,transform .22s;max-width:88vw;text-align:center;
}
.toast.show{opacity:1;transform:translate(-50%,0)}
.toast.bad{background:var(--danger);color:#fff}
.notice{
  background:var(--accent-soft);border:1px solid transparent;border-radius:14px;
  padding:12px 14px;font-size:12.5px;color:var(--accent);line-height:1.65;margin-bottom:12px;
}
.notice.warn{background:var(--warn-soft);color:var(--warn)}
.link-row{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.link-row a{
  text-decoration:none;font-size:12.5px;font-weight:600;color:var(--accent);
  background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:8px 12px;box-shadow:var(--shadow);
}
.kv{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid var(--line);font-size:13px}
.kv:last-child{border-bottom:0}
.kv span:first-child{color:var(--muted)}
.kv span:last-child{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:11.5px;text-align:right;word-break:break-all}
footer{text-align:center;color:var(--faint);font-size:11px;padding:22px 0 4px;line-height:1.7}

/* ---------- dialog ---------- */
.mask{
  position:fixed;inset:0;z-index:50;background:rgba(12,20,24,.42);
  display:grid;place-items:center;padding:24px;opacity:0;pointer-events:none;transition:opacity .2s;
  backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);
}
.mask.show{opacity:1;pointer-events:auto}
.dialog{
  width:100%;max-width:320px;background:var(--surface);border-radius:20px;padding:22px;
  box-shadow:0 20px 60px rgba(0,0,0,.24);transform:scale(.94);transition:transform .2s;
}
.mask.show .dialog{transform:scale(1)}
.dialog h3{margin:0 0 8px;font-size:16px}
.dialog p{margin:0 0 20px;font-size:13px;color:var(--muted);line-height:1.65}
.dialog .row{display:flex;gap:8px;justify-content:flex-end}
@media (prefers-reduced-motion: reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
<body>
<div class="app">
  <header class="topbar">
    <div class="brand">
      <div class="avatar" id="avatar"><span>🐾</span></div>
      <div class="brand-text">
        <div class="title">Coo 控制台</div>
        <div class="subtitle" id="subtitle">正在连接桌面的 Coo…</div>
      </div>
    </div>
    <div style="display:flex;gap:8px;align-items:center">
      <a class="icon-btn" href="/pet" title="去看桌宠" aria-label="去看桌宠" style="text-decoration:none">🐾</a>
      <button class="icon-btn" id="refreshBtn" title="刷新" aria-label="刷新">⟳</button>
    </div>
  </header>

  <nav class="tabs" role="tablist">
    <button class="tab active" data-tab="worlds" role="tab">World</button>
    <button class="tab" data-tab="settings" role="tab">设置</button>
    <button class="tab" data-tab="about" role="tab">关于</button>
  </nav>

  <main>
    <section class="panel active" id="panel-worlds">
      <div class="search-wrap">
        <span class="glass">⌕</span>
        <input type="text" id="worldSearch" placeholder="搜索 World 名称或 ID" autocomplete="off">
      </div>
      <div class="stats" id="stats"></div>
      <div id="worldList"><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div></div>
    </section>

    <section class="panel" id="panel-settings">
      <div class="notice">
        配置改动会写回桌面端的 config.json。标有「重启生效」的项需要重启对应 World 才会应用。
      </div>
      <div class="search-wrap">
        <span class="glass">⌕</span>
        <input type="text" id="configSearch" placeholder="搜索设置组或配置项" autocomplete="off">
      </div>
      <div id="configList"><div class="skeleton"></div><div class="skeleton"></div></div>
    </section>

    <section class="panel" id="panel-about">
      <div class="card">
        <div class="kv"><span>连接状态</span><span id="aboutState">—</span></div>
        <div class="kv"><span>World 总数</span><span id="aboutWorlds">—</span></div>
        <div class="kv"><span>配置组</span><span id="aboutGroups">—</span></div>
        <div class="kv"><span>入口</span><span id="aboutHost">—</span></div>
      </div>
      <div class="notice warn">
        这个地址等同于钥匙：任何拿到链接的人都能开关 World、修改设置。请勿外传。手机只经由桌宠服务访问，Core 的管理面板与密钥设置没有暴露到公网。
      </div>
      <div class="card">
        <div class="field-label">快捷入口</div>
        <div class="link-row">
          <a href="/pet">去看桌宠 ↗</a>
          <a href="/dress">换装 ↗</a>
        </div>
      </div>
      <div class="card">
        <div class="field-label">使用提示</div>
        <div class="field-desc" style="margin-top:8px">
          · 关闭 World 会立即从 Coo 身上撤下，重新打开会立即挂回，不需要重启整个应用。<br>
          · 「对 Coo 可见」只影响它能不能看到这个 World 的工具，World 本身仍在运行。<br>
          · 重启桌宠 World 会让页面短暂断开，等几秒自动恢复即可。
        </div>
      </div>
    </section>
  </main>

  <footer>Coo 手机控制台 · 与桌面同一只 Coo<br>链接含访问令牌，请妥善保管</footer>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>
<div class="mask" id="mask">
  <div class="dialog" role="dialog" aria-modal="true">
    <h3 id="dlgTitle">确认</h3>
    <p id="dlgBody"></p>
    <div class="row">
      <button class="btn" id="dlgCancel">取消</button>
      <button class="btn primary" id="dlgOk">确定</button>
    </div>
  </div>
</div>

<script type="module" src="/web/mobile-console.js"></script>
</body>
</html>
